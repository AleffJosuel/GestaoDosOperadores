# MODELO (vai para o git). A aplicação NÃO lê este arquivo — ela lê o .env.
# Já criei o .env com seus dados; este aqui fica só com valores de exemplo.

# Conta de supervisor (criada no boot se o e-mail ainda não existir). Senha com 12+ caracteres.
ADMIN_EMAIL=seu@email.com
ADMIN_PASSWORD=troque-por-uma-senha-com-12-ou-mais-caracteres

# Segredo para assinar o token de login (JWT). 32+ caracteres aleatórios. A app não sobe sem ele.
# Gere um, por exemplo, com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
# Opcional: validade do token em minutos (padrão 480 = 8h).
JWT_EXP_MIN=480

# Banco. Deixe assim para o PostgreSQL local / docker compose do projeto.
DB_URL=jdbc:postgresql://localhost:5432/gestao_operadores
DB_USER=gestao
DB_PASSWORD=gestao_dev

# Origens do front liberadas no CORS, separadas por vírgula. Localmente pode omitir
# (o padrão já é o Vite). Em produção: https://seu-app.vercel.app
CORS_ORIGENS=http://localhost:5173
