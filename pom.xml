<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>
  <groupId>br.com.gestao</groupId>
  <artifactId>operadores</artifactId>
  <version>1.0.0</version>
  <properties>
    <java.version>21</java.version>
    <!-- Build do front (Vite). Entra no JAR como classpath:/static — ver o bloco <build>. -->
    <frontend.dist>${project.basedir}/frontend/dist</frontend.dist>
  </properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-oauth2-resource-server</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <!-- Só pelo /actuator/health, para o monitoramento da TI saber se a aplicação está no ar. -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <!-- Parsing de CSV da importação (aspas, delimitadores, cabeçalho). -->
    <dependency><groupId>org.apache.commons</groupId><artifactId>commons-csv</artifactId><version>1.11.0</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <!-- O código-fonte fica em backend/; frontend/ é um projeto npm separado, fora do Maven. -->
    <finalName>gestao-operadores</finalName>
    <sourceDirectory>backend/src/main/java</sourceDirectory>
    <testSourceDirectory>backend/src/test/java</testSourceDirectory>
    <resources>
      <resource><directory>backend/src/main/resources</directory></resource>
    </resources>
    <testResources>
      <testResource><directory>backend/src/test/resources</directory></testResource>
    </testResources>
    <plugins>
      <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
      <!--
        Põe o site (frontend/dist) dentro do JAR, em /static: assim um único arquivo serve a
        interface e a API na mesma porta e na mesma origem — no servidor não é preciso Node,
        nginx nem IIS, e o CORS deixa de existir.

        O build do front NÃO é disparado aqui de propósito: Maven baixando Node tornaria o
        build do backend dependente de rede e de npm. A ordem é `npm run build` no frontend e
        depois `mvn package` — é o que o script empacotar.ps1 faz. Se frontend/dist não
        existir, o plugin apenas avisa e segue: o JAR sai só com a API.

        A fase é process-resources (e não prepare-package) para a cópia acontecer ANTES dos
        testes: é o que permite ao SubidaDaAplicacaoTest conferir o site sendo servido de
        verdade, e não só a API.
      -->
      <!--
        Apaga o site anterior antes de copiar o novo. O copy-resources só sobrescreve, nunca
        remove: como o Vite põe um hash no nome de cada arquivo, cada build deixava o bundle
        antigo para trás e o JAR ia acumulando versões mortas da interface a cada entrega.

        Roda em generate-resources, uma fase antes da cópia, para a ordem não depender da
        ordem de declaração dos plugins dentro de uma mesma fase.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>limpar-site-anterior</id>
            <phase>generate-resources</phase>
            <goals><goal>clean</goal></goals>
            <configuration>
              <!-- Sem isto, limparia target/ inteiro no meio do build. -->
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset><directory>${project.build.outputDirectory}/static</directory></fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copiar-front-para-o-jar</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
              <resources>
                <resource><directory>${frontend.dist}</directory></resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
