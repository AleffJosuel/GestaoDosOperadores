# Build (backend)
target/

# Pacote de entrega gerado pelo empacotar.ps1 (contém o JAR; é artefato, não fonte)
dist-entrega/

# Material de implantação (config modelo, scripts de servidor, guia da TI).
# Fora do versionamento por decisão: este repositório é público, e o guia descreve
# a infraestrutura interna — portas, procedimento de firewall, como as contas são
# criadas e o que o sistema ainda não protege.
#
# CONSEQUÊNCIA: um clone novo NÃO consegue gerar o pacote de entrega; o
# empacotar.ps1 para e avisa. Os arquivos precisam ser obtidos com quem mantém o
# projeto e ter backup fora do git.
implantacao/

# Build / dependências (frontend)
node_modules/
dist/
*.tsbuildinfo

# Segredos e ambiente
.env
.env.local
*.local.properties
application-local.properties

# IDE
.idea/
*.iml

# Dados reais da empresa — nunca versionar.
# Os CSVs de exemplo (dados fictícios) ficam liberados pela exceção abaixo.
*.xlsx
*.xls
*.csv
!exemplos-csv/*.csv

# Logs
*.log
